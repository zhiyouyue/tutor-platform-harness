# Server
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# MySQL（支持 MYSQL_* 或 db_* 两种写法）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=expert_platform
MYSQL_USER=zhiyouyue_writer
MYSQL_PASSWORD=
MYSQL_POOL_SIZE=10

# 或：
# db_host=localhost
# db_port=3306
# db_name=expert_platform
# db_user=zhiyouyue_writer
# db_password=

# Redis（可选；未启用时使用内存 noop cache）
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=tutor:

# 阿里云 RTC（dingrtc AppServer Token）
ALIYUN_RTC_ENABLED=true
ALIYUN_RTC_APP_ID=
ALIYUN_RTC_APP_KEY=
ALIYUN_RTC_TOKEN_TTL_SECONDS=7200

# 阿里云 OSS（课件/简历）
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
