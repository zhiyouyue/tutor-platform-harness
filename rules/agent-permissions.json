{
  "$schema": "./agent-permissions.schema.json",
  "version": "1.0.0",
  "roles": {
    "orchestrator": {
      "write": ["docs/", "knowledge/"],
      "read": ["**/*"],
      "run": ["npm test", "npm run build", "npm run structure-test -w core"],
      "trustSelfReport": false,
      "handoffWrite": ["docs/product-specs/features/*/handoff.json"]
    },
    "requirement_agent": {
      "write": ["docs/product-specs/features/*/requirements.md"],
      "read": ["docs/", "knowledge/"]
    },
    "architect_agent": {
      "write": ["docs/product-specs/features/*/design.md", "docs/design-docs/architecture/"],
      "read": ["docs/", "backend/", "frontend/", "rules/", "skills/"]
    },
    "planner_agent": {
      "write": ["docs/product-specs/features/*/tasks.md"],
      "read": ["docs/product-specs/features/*/"]
    },
    "contract_proposer": {
      "write": ["docs/product-specs/features/*/sprint-contract.md"],
      "read": ["docs/product-specs/features/*/"]
    },
    "contract_reviewer": {
      "write": ["docs/product-specs/features/*/sprint-contract.md"],
      "read": ["docs/product-specs/features/*/"],
      "trustSelfReport": false
    },
    "backend_agent": {
      "write": ["backend/src/**", "backend/tests/**"],
      "read": ["backend/", "docs/product-specs/features/*/"],
      "forbidden": ["backend/src/routes/**/models/**", "migrations/"]
    },
    "frontend_agent": {
      "write": ["frontend/src/**"],
      "read": ["frontend/", "backend/src/schemas/**", "docs/product-specs/features/*/"]
    },
    "db_agent": {
      "write": ["migrations/**"],
      "humanApproval": true
    },
    "test_agent": {
      "write": ["**/tests/**", "**/*.test.ts", "**/*.spec.ts", "docs/product-specs/features/*/tests.md", "docs/product-specs/features/*/sprint-contract.md"],
      "read": ["**/*"],
      "trustSelfReport": false
    },
    "review_agent": {
      "write": [],
      "read": ["**/*"],
      "skills": ["architecture-guard", "pr-review-architecture"],
      "trustSelfReport": false
    },
    "security_agent": {
      "write": [],
      "read": ["**/*"],
      "canBlockMerge": true
    },
    "knowledge_curator": {
      "write": ["knowledge/**"],
      "read": ["**/*"]
    }
  },
  "globalForbidden": [
    "force push to main",
    "skip CI hooks",
    "delete database columns without migration review",
    "production code without requirements.md"
  ]
}
